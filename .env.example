# Security Settings (REQUIRED)
# Generate a secure secret key with: python -c 'import secrets; print(secrets.token_hex(32))'
SECRET_KEY=your-secret-key-here-minimum-32-characters-long

# CORS Settings
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# Database
DB_PATH=data/processed/sales.duckdb

# Ollama LLM
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:14b

# Voice - STT (Speech-to-Text)
WHISPER_MODEL=bzikst/faster-whisper-large-v3-russian
WHISPER_LANGUAGE=ru

# Voice - TTS (Text-to-Speech)
PIPER_MODEL=ru_RU-irina-medium

# Security - JWT
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Paths
LOG_DIR=logs
DATA_DIR=data
DEMO_FILE=data/demo/demo_sales.csv

# Limits
MAX_RESULT_ROWS=1000
MAX_UPLOAD_SIZE_MB=50
